<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- __VERSION__ is filled in by packaging/macos/build-app.sh. -->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>io.github.andemt.hubwatch</string>
    <key>CFBundleName</key>
    <string>HubWatch</string>
    <key>CFBundleDisplayName</key>
    <string>HubWatch</string>
    <key>CFBundleExecutable</key>
    <string>HubWatch</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__VERSION__</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <!-- Starts as a menu bar app; the Dock icon appears while the window is open (AppDelegate.showWindow). -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- The UI is served over plain HTTP from localhost. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSHumanReadableCopyright</key>
    <string>MIT License</string>
</dict>
</plist>
